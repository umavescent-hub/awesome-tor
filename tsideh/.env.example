# Tsideh settings. Copy this file to .env for local use (npm start reads it).
# On Render, set these in the dashboard instead; never commit a real .env.
# Every setting is optional for a local demo: with nothing set, the site runs in
# demo mode on http://localhost:8787 with no real charges.

# --- Server -------------------------------------------------------------------
# Port and interface to listen on. Render sets PORT for you.
PORT=8787
HOST=0.0.0.0

# "production" on the live site. Production requires PUBLIC_URL (https) and turns on
# HSTS, secure cookies and the http -> https redirect.
NODE_ENV=development

# The address customers use, with no trailing path. Stripe sends customers back here.
# Required in production, e.g. https://tsideh.com
PUBLIC_URL=

# Where the order database lives. On Render this is the persistent disk, /data.
DATA_DIR=./data

# Number of proxies in front of the app. 1 on Render (its load balancer); 0 when the
# app is reached directly. Used for client IPs (rate limits) and https detection.
TRUST_PROXY=0

# --- Payments (Stripe) ----------------------------------------------------------
# Secret key from Stripe > Developers > API keys. Starts with sk_test_ (testing) or
# sk_live_ (real money). Leave empty for demo mode. Never use the publishable pk_ key.
STRIPE_SECRET_KEY=

# Signing secret of your webhook endpoint (https://YOURDOMAIN/api/stripe/webhook).
# Starts with whsec_. Test and live endpoints each have their own secret.
STRIPE_WEBHOOK_SECRET=

# --- Kitchen admin ---------------------------------------------------------------
# Password for /admin, at least 12 characters. Leave empty to switch the admin off.
ADMIN_PASSWORD=

# --- Alerts ------------------------------------------------------------------------
# Slack incoming-webhook URL (or any service that accepts {"text": "..."}).
# Posts a line for every paid order and every catering inquiry.
NOTIFY_WEBHOOK_URL=

# --- Development only ----------------------------------------------------------------
# Freeze the clock at an ISO time to preview the site as of another day.
# Ignored in production.
# NOW=2026-11-20T18:00:00Z

# Point the Stripe client somewhere else (tests use a local fake). Leave unset.
# STRIPE_API_BASE=https://api.stripe.com
